        s1_0.id,
        s1_0.created_at,
        s1_0.email,
        s1_0.name,
        s1_0.password,
        s1_0.role,
        l1_0.size,
        l1_0.status,
        l1_0.title,
        l1_0.updated_at,
        pp1_0.payment_frequency,
        pp1_0.plan_name,
        pp1_0.status,
        pp1_0.terms,
        pp1_0.total_amount,
        pp1_0.updated_at 
    from
        payment_plan pp1_0 
    left join
        lands l1_0 
            on l1_0.id=pp1_0.land_id 
    left join
        users s1_0 
            on s1_0.id=l1_0.seller_id 
    order by
        pp1_0.created_at desc
